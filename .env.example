# Local Compose configuration. Secrets are separate files in ./secrets.
VIDHARBOR_PORT=8085
VIDHARBOR_SECRETS_DIR=./secrets
VIDHARBOR_DB_NAME=vidharbor
VIDHARBOR_DB_USER=vidharbor
VIDHARBOR_RABBITMQ_USER=vidharbor
VIDHARBOR_MAX_UPLOAD_BYTES=5368709120
# VIDHARBOR_PUBLIC_BASE_URL=https://video.example.invalid
# VIDHARBOR_FFMPEG_TIMEOUT=10800
# Set to 1 only on a demo where visitors may upload from their own browser session.
VIDHARBOR_DEMO_STUDIO=0
